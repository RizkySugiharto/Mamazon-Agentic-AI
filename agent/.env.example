# ─────────────────────────────────────────────────────────────────────────────
# Mamazon Spade Agent — environment template
# Copy to `agent/.env` and fill in what you have. Everything has a safe default:
# with this file empty the agent still runs end-to-end on mock Vision + mock
# Drive + the local xlsx fixture.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Adapters ────────────────────────────────────────────────────────────────
# One provider for BOTH Vision (evidence screenshots) and #ai-chat.
# openrouter | opencode | opencode-api   (mock = offline tests only, not a production provider)
# Tencent / Hunyuan and Antigravity / agy provider values were REMOVED.
AI_PROVIDER=openrouter
# auto | mock | google       (auto = google when service_account.json exists)
DRIVE_PROVIDER=auto
# xlsx | gsheets
SHEET_SOURCE=xlsx

# ─── Google Sheets (live spreadsheet) ───────────────────────────────────────
# Paste the spreadsheet id or the full URL. Share the file with the service
# account below as Viewer, and enable the Sheets API in the GCP project.
#   https://docs.google.com/spreadsheets/d/<ID>/edit
GOOGLE_SPREADSHEET_ID=
# GOOGLE_SHEETS_CREDENTIALS=config/service_account.json

# ─── OpenRouter (AI_PROVIDER=openrouter; Vision + chat) ─────────────────────
#   key: https://openrouter.ai/keys
#   Model ids are "provider/model"; the same model is used for Vision and chat
#   and MUST accept image input. No model is substituted silently.
#   List vision-capable models: python -m src.main vision-status --models 20
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_TIMEOUT=90
OPENROUTER_MAX_IMAGES=8
OPENROUTER_MAX_TOKENS=3000
OPENROUTER_JSON_MODE=true
# low|medium|high — reasoning models need this or they return empty content
OPENROUTER_REASONING_EFFORT=
# Optional attribution (only affects OpenRouter leaderboards)
OPENROUTER_SITE_URL=https://github.com/mamazon/spade-agent
OPENROUTER_APP_NAME=Mamazon Spade Agent

# ─── Local OpenCode CLI (AI_PROVIDER=opencode; Vision + chat) ───────────────
# Local CLI only: spawns the installed `opencode` binary via headless
# `opencode run` — no HTTP endpoint, no API key. This is NOT the HTTP API
# (use the OPENCODE_API_* block below for AI_PROVIDER=opencode-api).
# Run `opencode models` and copy one exact provider/model; no default is guessed.
# The model must be vision-capable: screenshots are attached with repeated --file.
# Windows: bare `opencode` may fail (WinError 2 / FileNotFoundError); set the
# absolute ...\opencode.CMD path — resolved via shutil.which to the real binary.
OPENCODE_CLI=opencode
OPENCODE_MODEL=
OPENCODE_TIMEOUT=120
OPENCODE_AGENT=plan
# Blank or an absolute isolated directory. Blank defaults to agent/tmp/opencode_ai;
# relative values are resolved under agent/tmp. Must NOT contain .env / secrets.
OPENCODE_CWD=
OPENCODE_MAX_IMAGES=8
OPENCODE_MAX_PROMPT_CHARS=12000

# ─── OpenCode API / HTTP (AI_PROVIDER=opencode-api; Vision + chat) ──────────
# Official OpenAI-compatible inference API — DISTINCT from the local CLI above.
#   endpoint (base): https://opencode.ai/inference/openai/v1
#   Go / paid base:  https://opencode.ai/inference/go/openai/v1
#   key:      create in the OpenCode Console (Console / inference API)
#   models:   GET https://opencode.ai/inference/v1/models
# OPENCODE_API_BASE_URL accepts a base URL or a full .../chat/completions URL.
# Exact bare model id required (no guessed default); an "opencode/<id>" value is
# normalized to the bare id. Example: nemotron-3.5-super-vl-free — but NOTE free
# "-free" models are blocked for external API (403/429 FreeUsageLimitError): use
# a paid / Go model here, or the free model via AI_PROVIDER=opencode (local CLI).
# Custom User-Agent + Accept are sent on every request (default Python-urllib UA
# gets Cloudflare 403 error 1010). No silent paid-model switching.
# Vision sends base64 image_url data-URL parts; chat uses the same model.
OPENCODE_API_BASE_URL=https://opencode.ai/inference/openai/v1
OPENCODE_API_KEY=
OPENCODE_API_MODEL=
OPENCODE_API_USER_AGENT=MamazonSpadeAgent/1.0 (+OpenCode-API)
# Optional session id sent as the x-opencode-session header.
OPENCODE_API_SESSION_ID=
OPENCODE_API_TIMEOUT=90
OPENCODE_API_MAX_IMAGES=8
OPENCODE_API_MAX_TOKENS=3000

# ─── Chat rewriting (only affects #ai-chat, NOT Vision) ─────────────────────
# CHAT_ENABLED=false returns deterministic grounded answers in chat but leaves
# Vision/evidence reading untouched. These do not select a provider or model.
CHAT_ENABLED=true
CHAT_TIMEOUT=30
CHAT_MAX_TOKENS=2000

# ─── Bounded agent tools (no LangChain, no arbitrary code execution) ────────
# Explicit tools: ingat/catat/recall/forget, hitung, cari aturan, cari web,
# status ai — all under the same role gates as the slash commands.
CHAT_TOOLS_ENABLED=true
# Explicit long-term memory, persisted per member as JSON.
CHAT_MEMORY_ENABLED=true
# Blank uses agent/output/chat_memory.json; set an absolute path to override.
CHAT_MEMORY_PATH=
CHAT_MEMORY_MAX_ITEMS=20
CHAT_INCLUDE_TEMPLATES=false
AGENT_RULES_PATH=data/rules/agent_rules.md
# Optional web search: "cari web" works only when WEB_SEARCH_URL is configured.
# WEB_SEARCH_API_KEY is sent as a Bearer token (keep it secret / never commit).
WEB_SEARCH_URL=
WEB_SEARCH_API_KEY=
WEB_SEARCH_TIMEOUT=10
WEB_SEARCH_MAX_RESULTS=3

# Private member fines: koor binds Discord user IDs to exact roster names.
# DISCORD_MEMBER_MAP={"123456789012345678":"Nama Lengkap di Roster"}

# ─── 9Router Gateway & Voice Settings ─────────────────────────────────────────
# Unified AI gateway (Vision, Chat, Voice transcription)
NINEROUTER_BASE_URL=http://localhost:20128/v1
NINEROUTER_API_KEY=
NINEROUTER_MODEL=mamazon
NINEROUTER_WHISPER_MODEL=groq/whisper-large-v3-turbo
NINEROUTER_WHISPER_TIMEOUT=60
# Toggle voice note / audio file transcription in #ai-chat on or off (default: true)
VOICE_DETECTION_ENABLED=true

